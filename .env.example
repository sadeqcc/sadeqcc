# Required in production — used to sign the session cookie (min 16 chars).
AUTH_SECRET=change-me-to-a-long-random-string

# Storage. Default is a local SQLite file that persists between restarts.
DATABASE_URL=file:./data/sadeq.db

# For a hosted deployment (Vercel + Turso / libSQL) use instead:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token
